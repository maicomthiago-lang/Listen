# Copie este arquivo para .env e informe seu token do AudD (https://audd.io/)
# Use "test" apenas para demonstração (limite compartilhado de 10 chamadas/dia).
AUDD_API_TOKEN=test

# Opcional: integração oficial com YouTube Data API v3 (Playlist offline com YouTube Premium)
# Crie um OAuth Client ID (Web application) em https://console.cloud.google.com/
# Authorized redirect URI local: http://127.0.0.1:8000/api/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FLASK_SECRET_KEY=

# Opcionais para execução local
HOST=127.0.0.1
PORT=8000
